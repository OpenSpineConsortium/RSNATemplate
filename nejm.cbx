\ProvidesFile{nejm.cbx}[2021/07/09 v0.1 biblatex bibliography style]

\RequireCitationStyle{ext-numeric-comp}

% First after last name
\DeclareNameAlias{default}{family-given}

% No punctuation inside names
\renewcommand*{\revsdnamepunct}{}

% Cite with round parenthesis
\DeclareOuterCiteDelims{cite}{\bibopenparen}{\bibcloseparen}
%\DeclareOuterCiteDelims{parencite}{\bibopenparen}{\bibcloseparen}
%\DeclareOuterCiteDelimsAlias{cite}{parencite}
%\DeclareInnerCiteDelims{textcite}{\bibopenparen}{\bibcloseparen}
\renewcommand{\textcite}[1]{\citeauthor{#1}~\cite{#1}}